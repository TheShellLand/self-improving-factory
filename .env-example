SIFH_DB_PATH=/app/data/history_vault.db
SIFH_IMAGE=sifh_runtime
SIFH_API_HOST=0.0.0.0
SIFH_API_PORT=8000
SIFH_TASK_TIMEOUT=600
SIFH_CLEANUP_TIMEOUT=10
SIFH_POLL_INTERVAL=5

SIFH_PI_EXECUTABLE=pi
SIFH_TIMEOUT=120
SIFH_PI_CLEANUP_TIMEOUT=5
SIFH_PI_MAX_RECORD_BYTES=1048576
SIFH_PI_MAX_EVENTS=10000
# Optional: set SIFH_MODEL and SIFH_PROVIDER to select a model and provider.
# Otherwise leave them unset to use pi defaults. Empty values are invalid.
# Supply provider credentials through their native environment variables.
