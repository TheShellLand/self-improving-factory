SIF_DB_PATH=/app/data/history_vault.db
SIF_IMAGE=sif_runtime
SIF_API_HOST=0.0.0.0
SIF_API_PORT=8000
SIF_TASK_TIMEOUT=600
SIF_CLEANUP_TIMEOUT=10
SIF_POLL_INTERVAL=5

SIF_PI_EXECUTABLE=pi
SIF_TIMEOUT=120
SIF_PI_CLEANUP_TIMEOUT=5
SIF_PI_MAX_RECORD_BYTES=1048576
# Optional: set SIF_MODEL and SIF_PROVIDER to select a model and provider.
# Otherwise leave them unset to use pi defaults. Empty values are invalid.
# Supply provider credentials through their native environment variables.
